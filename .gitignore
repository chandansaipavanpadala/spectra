# ==========================================
# Vivado Auto-Generated Project Files & Caches
# ==========================================
*.xpr
*.log
*.jou
*.str
*.pb
.Xil/
*.runs/
*.cache/
*.hw/
*.sim/
*.ip_user_files/
*.gen/
spectra.sim/
spectra.cache/
spectra.hw/
spectra_prj/
vivado_project/
vivado_project_base/

# Allow tracking of hardware co-simulation CSV traces and Vivado reports
!reports/*.csv
!reports/vivado_*.txt
!references/implementation/reports/*.csv
!references/implementation/reports/vivado_*.txt

# Output bitstreams and binary reports
*.bit
*.bin
*.sysdef
*.hdf

# ==========================================
# Simulation Outputs & Waveform Trace Dumps
# ==========================================
*.vcd
*.wdb
*.vdb
work/
transcript
xsim.dir/

# ==========================================
# Benchmark Documentation & Non-Code Files
# ==========================================
benchmarks/**/*.pdf
benchmarks/**/*.doc*

# ==========================================
# Python & Machine Learning Caches
# ==========================================
__pycache__/
*.pyc
.venv/
venv/
*.pkl
.pytest_cache/

# ==========================================
# System & Editor Caches
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ==========================================
# LaTeX Intermediate Build Artifacts (Documentation)
# ==========================================
documentation/*.aux
documentation/*.log
documentation/*.toc
documentation/*.lof
documentation/*.lot
documentation/*.out
documentation/*.fls
documentation/*.fdb_latexmk
documentation/*.synctex.gz
